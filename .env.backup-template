# ⚠️ 실제 .env 백업본에서 비밀값 3개(봇 토큰·OpenAI 키·TronGrid 키)만 비운 파일입니다.
# 복구: 이 파일을 .env 로 복사한 뒤 비어 있는 3개만 다시 채우세요.
#   봇 토큰: BotFather /token · OpenAI: platform.openai.com/api-keys · TronGrid: trongrid.io 대시보드

# ── 필수 ───────────────────────────────────────────────
# BotFather에서 발급한 봇 토큰
TELEGRAM_BOT_TOKEN=
# https://platform.openai.com/api-keys 에서 발급 (사용 한도 꼭 설정)
OPENAI_API_KEY=
# 봇 오너 텔레그램 숫자 ID (쉼표로 여러 명). @userinfobot 에게 말 걸면 알 수 있음
OWNER_IDS=

# ── 봇 캐릭터 ──────────────────────────────────────────
BOT_NAME=소담
# 이 단어로 시작하는 메시지에 반응 (쉼표 구분)
BOT_CALL_NAMES=소담아,소담이,소담

# ── OpenAI 모델 ────────────────────────────────────────
OPENAI_MODEL=gpt-5.4
# 인젝션 판별 / 게임 문제 생성 같은 가벼운 작업용
OPENAI_GUARD_MODEL=gpt-5.4-mini
# 추론 모델일 때만 사용 (minimal/low/medium/high). 에러 나면 비워두기
OPENAI_REASONING_EFFORT=low
# 하루 전체 토큰 한도 (넘으면 AI 응답 중지, 관리 기능은 계속 동작)
DAILY_TOKEN_BUDGET=2000000

# ── 기타 ───────────────────────────────────────────────
DB_PATH=data/sodam.db
TIMEZONE=Asia/Seoul
# 관리 로그를 보낼 채팅 ID (비공개 관리자방 등). 비우면 안 보냄
LOG_CHAT_ID=
# TheSportsDB API 키 (무료 테스트 키: 123)
SPORTSDB_KEY=123
# CAS 스팸DB 조회 주소 (보통 바꿀 필요 없음)
CAS_API=https://api.cas.chat/check

# ── DB 자동 백업 ───────────────────────────────────────
BACKUP_DIR=data/backups
# 최근 N개만 보관
BACKUP_KEEP=14
# 매일 백업 시각 (HH:MM, TIMEZONE 기준)
BACKUP_TIME=05:00
# true 면 백업 파일을 LOG_CHAT_ID 로도 전송 (대화 기록이 들어 있으니 비공개 관리자방일 때만)
BACKUP_SEND_TO_LOG=false


# ── 구독 결제 (USDT TRC20) ── 주소만! 개인키·시드는 절대 넣지 말 것
PAY_ADDRESS=TSyV5keqjKZtKPuJuiktZai28X8oodeKpH
# 처음엔 1 USDT 로 실제 테스트 → 확인되면 원하는 금액으로
SUB_PRICE_USDT=30
SUB_DAYS=30
TRIAL_DAYS=3
FREE_AI_PER_DAY=10
INVOICE_MINUTES=60
# trongrid.io 대시보드 → API Keys 에서 발급해 붙여넣기
TRONGRID_API_KEY=
# (선택) MTProto 도우미: my.telegram.org → API development tools (비우면 꺼짐)
MTPROTO_API_ID=
MTPROTO_API_HASH=
