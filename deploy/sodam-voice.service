# /etc/systemd/system/sodam-voice.service — 📞 음성채팅 담당 (sodam/voice/worker.py, docs: CLAUDE.md '음성채팅').
# 도우미 계정 로그인·통화를 맡음. 봇 본체와는 DB(voice_jobs)로만 이야기 → 이게 죽어도 본체는 그대로.
# deploy/update.sh 가 설치·재시작. 로그: journalctl -u sodam-voice -f
[Unit]
Description=Sodam voice chat worker
Wants=network-online.target
After=network-online.target sodam.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=sodam
Group=sodam
WorkingDirectory=/opt/sodam
ExecStart=/opt/sodam/.venv/bin/python -m sodam.voice.worker
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# 노래 받기는 WARP 우회 길로 먼저 (sodam-warp·sodam-warp2 두 길, 지난번에 된 길부터). 다 죽어 있으면 코드가 바로 예전 방식(쿠키)으로
Environment=MUSIC_PROXY=socks5://127.0.0.1:40000,socks5://127.0.0.1:40001
# 🎧 음질 (오디오 실험실, docs/AUDIO_LAB.md): 고친 ntgcalls(/opt/sodam-hq, update.sh 가 설치)가 읽음 — 원래 부품이면 무시됨.
# 64kbps (모노). stereo=1 은 끔 — 2026-10-09 "다시 켰더니 2배속" 의심 (모노 조각을 두 귀로 읽으면 딱 2배). 원래 = 32kbps 모노 통화 모드.
# 128k 였을 때 서버는 357초 동안 밀림·빈 조각 0 인데 방에선 '끊긴다' (2026-10-09 21:46 일루왕) → 꾸러미가 커서(997바이트) 듣는 쪽 약한 인터넷에서 빠지는 것으로 보고 절반으로.
Environment=NTG_OPUS_BITRATE=64000
Restart=always
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sodam-voice
UMask=0077
# 통화는 10 ms 마다 소리를 보내야 함 → CPU 가 모자랄 때 음성 담당 먼저 (자동 갱신 테스트는 CPUWeight=20).
# cgroup v2 에선 서비스끼리 CPU 나눔은 CPUWeight 가 정하고 Nice 는 같은 서비스 안에서만 → 둘 다 줌.
# (systemd.resource-control(5) CPUWeight · systemd.exec(5) Nice). update.sh voice_setup 이 이 파일이 바뀌면 설치·daemon-reload.
CPUWeight=1000
Nice=-5

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sodam/data
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# WebRTC(ntgcalls) 가 네트워크 장치 목록을 netlink 로 읽음 · 통화 소리는 UDP
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
