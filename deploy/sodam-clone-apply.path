# /etc/systemd/system/sodam-clone-apply.path — data/clones 디렉터리가 바뀌면(클론 .env 추가·삭제)
# sodam-clone-apply.service 를 실행해 sodam@<slug> 를 자동으로 켜고 끈다.
[Unit]
Description=Watch sodam clone .env directory

[Path]
PathModified=/opt/sodam/data/clones
Unit=sodam-clone-apply.service
MakeDirectory=true
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
