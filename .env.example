# ── 필수 ───────────────────────────────────────────────
# BotFather에서 발급한 봇 토큰
TELEGRAM_BOT_TOKEN=
# https://platform.openai.com/api-keys 에서 발급 (사용 한도 꼭 설정)
OPENAI_API_KEY=
# 봇 오너 텔레그램 숫자 ID (쉼표로 여러 명). @userinfobot 에게 말 걸면 알 수 있음
OWNER_IDS=

# ── 봇 캐릭터 ──────────────────────────────────────────
BOT_NAME=소담
# 이 단어로 시작하는 메시지에 반응 (쉼표 구분)
BOT_CALL_NAMES=소담아,소담이,소담

# ── OpenAI 모델 ────────────────────────────────────────
OPENAI_MODEL=gpt-5.4
# 인젝션 판별 / 게임 문제 생성 같은 가벼운 작업용
OPENAI_GUARD_MODEL=gpt-5.4-mini
# 추론 모델일 때만 사용 (minimal/low/medium/high). 에러 나면 비워두기
OPENAI_REASONING_EFFORT=low
# 생각하는 에이전트: auto(기본: 관리자·오너 요청 + 여러 단계·'왜' 요청을 Responses API 로 추론+도구, 멤버 잡담은 예전 방식)
# / off(전부 예전 방식) / always. 그 요청만 조금 비쌈 (추론 토큰). 비교: AGENT_THINK=off python tools/ai_eval_tools.py
AGENT_THINK=auto
AGENT_THINK_EFFORT=low
# 하루 전체 AI 요금 한도 (달러, 넘으면 AI 응답 중지, 관리 기능은 계속 동작). 0 = 끔
DAILY_USD_BUDGET=8
# (선택) 하루 토큰 한도. 적어 두면 달러 한도와 함께 지킴 — 캐시 입력도 전부 세서 실제 요금보다 빨리 막히니 보통은 비워 둠
# DAILY_TOKEN_BUDGET=4000000
# 프롬프트 캐시 보관: 비우면 기본(수 분), 24h 면 하루 보관 (대화가 띄엄띄엄인 방에서 적중률↑, 모델이 지원해야 함)
OPENAI_CACHE_RETENTION=

# ── 기타 ───────────────────────────────────────────────
DB_PATH=data/sodam.db
TIMEZONE=Asia/Seoul
# 관리 로그를 보낼 채팅 ID (비공개 관리자방 등). 비우면 안 보냄
LOG_CHAT_ID=
# TheSportsDB API 키 (무료 테스트 키: 123)
SPORTSDB_KEY=123
# CAS 스팸DB 조회 주소 (보통 바꿀 필요 없음)
CAS_API=https://api.cas.chat/check
# 두 번째 스팸 명단(lols) 조회 주소. 비우면 조회 안 함
LOLS_API=https://api.lols.bot/account

# ── 구독 결제 (USDT TRC20) ─────────────────────────────
# 받는 주소 (아임토큰 → TRX 또는 USDT(TRC20) → 받기 주소). 비우면 결제 기능 꺼짐 = 모든 방 무료
# ⚠️ 주소만 넣는다. 개인키·시드(니모닉)는 절대 여기나 서버에 두지 말 것
PAY_ADDRESS=
# 방당 월 요금(USDT), 이용 일수, 처음 들어간 방 무료 체험 일수
SUB_PRICE_USDT=30
SUB_DAYS=30
TRIAL_DAYS=3
# 구독 안 한 방(체험 끝) 하루 무료 AI 호출 수. 방 관리(캡차·도배 방지 등)는 구독과 상관없이 계속 동작
FREE_AI_PER_DAY=10
# 청구서 유효 시간(분)
INVOICE_MINUTES=60
# https://www.trongrid.io 무료 API 키 (없으면 조회가 느리거나 막힐 수 있음)
TRONGRID_API_KEY=

# ── DB 자동 백업 ───────────────────────────────────────
BACKUP_DIR=data/backups
# 최근 N개만 보관
BACKUP_KEEP=14
# 매일 백업 시각 (HH:MM, TIMEZONE 기준)
BACKUP_TIME=05:00
# true 면 백업 파일을 LOG_CHAT_ID 로도 전송 (대화 기록이 들어 있으니 비공개 관리자방일 때만)
BACKUP_SEND_TO_LOG=false

# (선택) MTProto 도우미 — Bot API 로 못 얻는 참가자 목록 등 (sodam/mtproto.py). my.telegram.org → API development tools
# 에서 받은 값. 비우면 꺼짐. 채널 조회수(사용자 세션)는 서버에서 python tools/mtproto_login.py 를 따로 실행해야 켜짐
MTPROTO_API_ID=
MTPROTO_API_HASH=
